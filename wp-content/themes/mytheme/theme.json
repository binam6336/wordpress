{
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "700px",
			"wideSize": "1100px"
		},
		"useRootPaddingAwareAlignments": true,
		"color": {
			"palette": [
				{
					"slug": "canvas",
					"name": "Canvas",
					"color": "#141213"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#211d1f"
				},
				{
					"slug": "raised",
					"name": "Raised",
					"color": "#2c2629"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#f5eae3"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#c9b9b3"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#56494d"
				},
				{
					"slug": "rose",
					"name": "Rose",
					"color": "#e4b4b3"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|canvas",
			"text": "var:preset|color|ink"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|rose"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|rose",
					"text": "var:preset|color|canvas"
				},
				"border": {
					"radius": "6px"
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 3rem)",
				"right": "clamp(1rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"lineHeight": "1.7",
			"fontFamily": "system-ui, Tahoma, sans-serif"
		}
	}
}
