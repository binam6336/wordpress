{
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "700px",
			"wideSize": "1100px"
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "#faf9f6",
			"text": "#222723"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#205744"
				}
			}
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 3rem)",
				"right": "clamp(1rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"lineHeight": "1.7"
		}
	}
}
